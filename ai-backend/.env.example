API_NAME=wahl-chat-api
ENV=dev

# --- Local data store selection (LOCAL-02) ---
# These two vars route all store clients to local emulators in dev mode.
# Copy this file to ai-backend/.env and fill in values for your environment.
#
# Local mode (default for development — no prod credentials needed):
QDRANT_URL=http://localhost:6333
FIRESTORE_EMULATOR_HOST=localhost:8081

# --- LLM / AI API keys (required for chat functionality) ---
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key

# --- DIP (Bundestag) API key for bundestag_speeches connector ---
# Keys rotate ~monthly; fetch the current public key from:
#   https://dip.bundestag.de/über-dip/hilfe/api
DIP_API_KEY=your_dip_api_key
# DIP_WAHLPERIODE=21  # Optional: Bundestag legislature period (default 21)

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=wahl-chat-dev

# --- Azure OpenAI (optional alternative to OpenAI) ---
OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key

# --- Qdrant Cloud (prod only — leave unset in local mode) ---
# QDRANT_API_KEY=your_qdrant_api_key
# (QDRANT_URL above points at localhost for local dev;
#  set to your Qdrant Cloud URL for prod)

# --- Perplexity (optional) ---
PERPLEXITY_API_KEY=perplexity_api_key
