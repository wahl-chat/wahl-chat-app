# Copy this file to ingestion/.env and fill in values for your environment.
#
# If you already keep every key in ai-backend/.env, that keeps working: the
# ingestion CLIs load ingestion/.env when it exists and fall back to
# ai-backend/.env otherwise. A deployed ingestion Job has no .env file at all —
# the job-spec environment passes through untouched.

ENV=dev

# --- Qdrant (the corpus store) ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key   # deployed stores only

# --- Embeddings provider (corpus vector space) ---
# These define the vector space the corpus is written in, and are stamped into
# the collection as a fingerprint. The backend verifies that fingerprint on
# every query, so changing them means a full re-ingest into a fresh collection
# — and the same values must be set on the backend.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072

# --- Embedding API keys ---
# OPENAI_API_KEY is always required (it is the built-in default provider).
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key

# --- Vertex AI (optional): bill Gemini embeddings to a separate GCP project ---
# When a service-account key for the billing project is configured, embeddings
# are routed through Vertex AI and billed there; AI Studio (GOOGLE_API_KEY)
# stays registered at a lower priority. Leave everything below unset — as in CI
# — and behaviour is exactly as if this feature did not exist.
#
# Cloud Run: inject the raw JSON from Secret Manager.
#   --set-secrets="VERTEX_SA_JSON=vertex-sa-json:latest"
# VERTEX_SA_JSON={"type":"service_account",...}
#
# Local dev: point at a file instead (multiline JSON in dotenv is fragile).
# The file is gitignored and excluded from the Docker build context.
# VERTEX_SA_JSON_FILE=vertex-sa.json
#
# VERTEX_PROJECT_ID=your_vertex_billing_project
# VERTEX_LOCATION=global
#
# Kill-switch: set to 0 to keep embeddings on AI Studio.
# EMBEDDINGS_USE_VERTEX=1
#
# Strict mode: a key that was SUPPLIED but is unusable raises instead of
# falling back. Set on deployed revisions, leave unset in CI and local dev.
# VERTEX_REQUIRED=1

# --- DIP (Bundestag) API key for the bundestag_speeches connector ---
# Keys rotate ~monthly; fetch the current public key from:
#   https://dip.bundestag.de/über-dip/hilfe/api
DIP_API_KEY=your_dip_api_key
# DIP_WAHLPERIODE=21  # Optional: Bundestag legislature period (default 21)

# --- Abgeordnetenwatch (optional) ---
# Only needed if you hit rate limits on the votes connector.
# AW_API_KEY=your_aw_api_key

# --- manifesto_uploads connector ---
# Where the manifest and election fixtures come from. Defaults suit local dev
# (repo files); a containerised run needs the bucket/Firestore sources.
# MANIFESTO_UPLOADS_SOURCE=bucket
# ELECTION_FIXTURES_SOURCE=firestore
# FIRESTORE_EMULATOR_HOST=localhost:8081
