# === Planning (local only) ===
.planning/
# Agent-local runtime state only — committed assets under .claude/ (skills,
# agents, settings.json) MUST remain tracked, so ignore the local runtime
# files individually rather than the whole directory.
.claude/settings.local.json
.claude/*.local.json
.claude/worktrees/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/history.jsonl
.claude/skills

infra-example-export

# === Common ===
.DS_Store
.idea/
.vscode/
*.pem
.next
node_modules/
.pnpm-store
.claude/skills

# === Environment / secrets ===
.env
.env.*
!.env.example
*firebase-adminsdk*.json
# Vertex AI service-account key (billing project) — runtime-provided only.
vertex-sa*.json

# === Python runtime (repo-wide, not backend-only) ===
# Python lives in several dirs: ai-backend/, firebase/ (incl. a local venv),
# scripts/, and web/ tooling.
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/

# === Terraform ===
# infra/ (the clean, example-modeled IaC) IS committed. The old bulk-export dirs are
# reference-only and stay fully ignored — they contain plaintext secrets + local state:
terraform/
terraform-export/
# Within committed roots, ignore local state, plugin cache and plans — but NOT the
# *.tf sources or the committed .terraform.lock.hcl:
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Saved `terraform plan` / import output can contain plaintext secret values — never commit:
plan*.txt
*.plan.txt
import*.log
# Local-only operator handoff — describes in-progress migration state / current exposure.
# Keep on the operator's machine; do NOT push to the public repo.
terraform_next_steps.md
# Local-only, one-time operator scripts (brownfield import + secret migration). They
# narrate the current migration state, so keep them off the public repo.
infra/envs/*/import.sh
infra/envs/*/migrate-secrets.sh

# === Misc ===
*.log
.local
ai-backend/vertex-sa.json
# === Local data files ===
speeches.jsonl

# === Agent docs symlink (local only) ===
# AGENTS.md is the committed source of truth; CLAUDE.md is a provider-specific
# symlink to it, created per-clone by ./scripts/setup-agent-docs.sh.
CLAUDE.md

# Party PDFs staged for upload to Firebase Storage (see firebase/storage_data/public/NOTE.md).
# The documents themselves are not repo content — only the staging layout is.
firebase/storage_data/public/**/*.pdf
