# === Planning (local only) ===
.planning/
# Agent-local runtime state only — committed assets under .claude/ (skills,
# agents, settings.json) MUST remain tracked, so ignore the local runtime
# files individually rather than the whole directory.
.claude/settings.local.json
.claude/*.local.json
.claude/worktrees/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/history.jsonl

# === Common ===
.DS_Store
.idea/
.vscode/
*.pem
.next
node_modules/

# === Environment / secrets ===
.env
.env.*
!.env.example
*firebase-adminsdk*.json

# === Python runtime (repo-wide, intentionally not backend-only) ===
# Python lives in several directories — ai-backend/ (the main package),
# firebase/ (functions + seed script, incl. a local venv), scripts/ (CI guards),
# and web/ tooling — so these artefacts can appear anywhere in the tree. A single
# top-level rule covers them all rather than duplicating a Python .gitignore into
# each dir. (ai-backend/.gitignore additionally scopes its backend-only ignores.)
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/

# === Misc ===
*.log
.local

# === Local data files ===
speeches.jsonl

# === Agent docs symlink (local only) ===
# AGENTS.md is the committed source of truth; CLAUDE.md is a provider-specific
# symlink to it, created per-clone by ./scripts/setup-agent-docs.sh.
CLAUDE.md
