# === Planning (local only) ===
.planning/
# Agent-local runtime state only — committed assets under .claude/ (skills,
# agents, settings.json) MUST remain tracked, so ignore the local runtime
# files individually rather than the whole directory.
.claude/settings.local.json
.claude/*.local.json
.claude/worktrees/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/history.jsonl

# === Common ===
.DS_Store
.idea/
.vscode/
*.pem
.next
node_modules/

# === Environment / secrets ===
.env
.env.*
!.env.example
*firebase-adminsdk*.json

# === Python runtime ===
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/

# === Misc ===
*.log
.local

# === Local data files ===
speeches.jsonl

# === Agent docs symlink (local only) ===
# AGENTS.md is the committed source of truth; CLAUDE.md is a provider-specific
# symlink to it, created per-clone by ./scripts/setup-agent-docs.sh.
CLAUDE.md
