API_NAME=wahl-chat-api
ENV=dev

# --- Local data store selection (LOCAL-02) ---
# These two vars route all store clients to local emulators in dev mode.
# Copy this file to ai-backend/.env and fill in values for your environment.
#
# Local mode (default for development — no prod credentials needed):
QDRANT_URL=http://localhost:6333
FIRESTORE_EMULATOR_HOST=localhost:8081

# --- LLM / AI API keys (required for chat functionality) ---
# OPENAI_API_KEY: fallback chat LLMs (GPT-4o-mini) when Gemini rate-limits.
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key

# --- Vertex AI (optional): bill Gemini to a separate GCP project ---
# When a service-account key for the billing project is configured, Gemini chat
# and embeddings are routed through Vertex AI and billed there. AI Studio
# (GOOGLE_API_KEY above) stays registered at a lower priority and takes over
# automatically on any Vertex error. Leave everything below unset — as in CI —
# and behaviour is exactly as if this feature did not exist.
#
# Cloud Run: inject the raw JSON from Secret Manager.
#   --set-secrets="VERTEX_SA_JSON=vertex-sa-json:latest"
# VERTEX_SA_JSON={"type":"service_account",...}
#
# Local dev: point at a file instead (multiline JSON in dotenv is fragile).
# The file is gitignored and excluded from the Docker build context.
# VERTEX_SA_JSON_FILE=vertex-sa.json
#
# Billing project id. Optional — derived from the key when omitted — but set it
# explicitly so the target is obvious.
# VERTEX_PROJECT_ID=your_vertex_billing_project
#
# Vertex location. Defaults to "global", matching the AI Studio status quo (which
# has no regional pinning either). It is also the only location where
# gemini-embedding-2 and the 2.5-lite / 3-preview chat models resolve — regional
# endpoints serve gemini-2.5-flash alone and 404 on the rest.
# VERTEX_LOCATION=global
#
# Kill-switch: set to 0 to keep embeddings on AI Studio while chat uses Vertex.
# Embeddings have no runtime failover, so this is the manual escape hatch.
# EMBEDDINGS_USE_VERTEX=1

# --- Embeddings provider (corpus vector space) ---
# Must match the collection the vectors were written with: the corpus is
# embedded with Gemini, so query embedding must use the same model or
# retrieval returns cross-space garbage. Only change these together with a
# full re-ingest into a fresh collection.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072

# --- DIP (Bundestag) API key for bundestag_speeches connector ---
# Keys rotate ~monthly; fetch the current public key from:
#   https://dip.bundestag.de/über-dip/hilfe/api
DIP_API_KEY=your_dip_api_key
# DIP_WAHLPERIODE=21  # Optional: Bundestag legislature period (default 21)

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=wahl-chat-dev

# --- Azure OpenAI (optional alternative to OpenAI) ---
OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key

# --- Qdrant Cloud (prod only — leave unset in local mode) ---
# QDRANT_API_KEY=your_qdrant_api_key
# (QDRANT_URL above points at localhost for local dev;
#  set to your Qdrant Cloud URL for prod)

# --- Perplexity (optional) ---
PERPLEXITY_API_KEY=perplexity_api_key
