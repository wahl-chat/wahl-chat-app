set -e

# Frontend (web/): ESLint + Biome on staged JS/TS. bun is the web package
# manager, so run the locked lint-staged from web/node_modules — npx could
# fetch a different version when the local binary is missing.
(cd web && bun run lint-staged)

# Backend (ai-backend/): ruff + mypy + hygiene hooks on staged files. Run from
# the repo root (where .pre-commit-config.yaml lives); `uv run --project` is what
# makes the pre-commit tool resolvable, since it's an ai-backend venv dependency,
# not a repo-root one. The config self-scopes ruff/mypy to ai-backend/*.py.
uv run --project ai-backend pre-commit run
