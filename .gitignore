# === Planning (local only) ===
.planning/
# Agent-local runtime state only — committed assets under .claude/ (skills,
# agents, settings.json) MUST remain tracked, so ignore the local runtime
# files individually rather than the whole directory.
.claude/settings.local.json
.claude/*.local.json
.claude/worktrees/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/history.jsonl
.claude/skills

# === Common ===
.DS_Store
.idea/
.vscode/
*.pem
.next
node_modules/
.pnpm-store
.claude/skills

# === Environment / secrets ===
.env
.env.*
!.env.example
*firebase-adminsdk*.json
# Vertex AI service-account key (billing project) — runtime-provided only.
vertex-sa*.json
terraform/
terraform-export/

# === Python runtime (repo-wide, not backend-only) ===
# Python lives in several dirs: ai-backend/, firebase/ (incl. a local venv),
# scripts/, and web/ tooling.
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/

# === Terraform ===
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars

# Public repo: never commit raw bulk-export output or generated import artifacts.
# They can embed secrets, IAM policies, and a full map of the GCP attack surface.
# Review and sanitize manually before un-ignoring anything specific.
# raw gcloud bulk-export output
terraform-export/
# per-environment roots (main.tf, import.sh, state) — review before un-ignoring
terraform/
import_*.sh
modules_*.tf

# === Misc ===
*.log
.local
ai-backend/vertex-sa.json
# === Local data files ===
speeches.jsonl

# === Agent docs symlink (local only) ===
# AGENTS.md is the committed source of truth; CLAUDE.md is a provider-specific
# symlink to it, created per-clone by ./scripts/setup-agent-docs.sh.
CLAUDE.md

# Party PDFs staged for upload to Firebase Storage (see firebase/storage_data/public/NOTE.md).
# The documents themselves are not repo content — only the staging layout is.
firebase/storage_data/public/**/*.pdf
