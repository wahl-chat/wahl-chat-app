set -e

# Frontend (web/): ESLint + Biome on staged JS/TS. bun is the web package
# manager, so run the locked lint-staged from web/node_modules — npx could
# fetch a different version when the local binary is missing.
(cd web && bun run lint-staged)

# Python (ai-backend/ + ingestion/): ruff + mypy + hygiene hooks on staged
# files. Run from the repo root, which is both where .pre-commit-config.yaml
# lives and the uv workspace root — so the shared environment resolves
# pre-commit and the members' dev tools. The config self-scopes ruff/mypy to
# ai-backend/*.py and ingestion/*.py.
uv run pre-commit run
