# --- REQUIRED FOR LOCAL DEVELOPMENT ---

# App
SITE_URL=http://localhost:3000
# For local backend, see ../ai-backend/README.md
# Alternatively, set to a publicly hosted backend endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STREAMING_MESSAGE_TIMEOUT_MS=30000

# Wahl Agent Backend
WAHL_AGENT_BACKEND_URL=http://localhost:5000

# Firebase local emulators (fully-local dev — no real project touched).
# With this set to "true", the browser + server SDKs talk to the Firestore/Auth
# emulators started by `make stores-up` (ports from firebase/firebase.json), and
# the Admin SDK routes to the emulator and needs NO service-account key. Leave it
# unset/false to use the real project. FIRESTORE_EMULATOR_HOST /
# FIREBASE_AUTH_EMULATOR_HOST are the Admin/server-side switches.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firebase Client (Obtain from: Firebase Console > Project Settings > General > Your apps)
# With the emulators enabled these can be any non-empty placeholders; the
# emulator does not validate them (use a demo project id, e.g. demo-wahl-chat).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-wahl-chat.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-wahl-chat
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Firebase Admin (real project only — NOT needed when the emulators are enabled).
# Obtain from: Firebase Console > Project Settings > Service accounts.
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# --- OPTIONAL FOR LOCAL DEVELOPMENT ---

# Stripe (Only needed for donation features)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Prolific Study
PROLIFIC_COMPLETION_CODE=replace-me-with-an-actual-code
PROLIFIC_MIN_CHAT_INTERACTIONS=10

# Settings
BUDGET_SPENT=false
REVALIDATE_SECRET=
IS_EMBEDDED=false
