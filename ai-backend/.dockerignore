data/wahlprogramme/
firebase/
.venv/
# Secrets must NEVER enter the build context (COPY . /app would bake them).
.env
.env.*
# Firebase/GCP service-account private keys: a key copied into the image is
# baked into its layers forever. Provide credentials at runtime instead
# (mounted secret / Workload Identity / ADC), never via the build context.
*firebase-adminsdk*.json
*-adminsdk-*.json
serviceAccount*.json
*service-account*.json
application_default_credentials.json
# Test suite and tool caches are not needed in the image.
tests/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
