rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  	function getSession() {
      return get(/databases/$(database)/documents/chat_sessions/$(session_id)).data
    }

    match /wahl_swiper_theses/{question_id} {
    	allow read;
    }

    match /system_status/{id} {
    	allow read;
    }

    match /parties/{document=**} {
      allow read;
    }

    match /contexts/{context_id} {
      allow read;

      match /parties/{party_id} {
        allow read;
      }

      match /proposed_questions/{document=**} {
        allow read;
      }
    }

    match /cached_answers/{id} {
    	allow read;
    }

    match /cached_answers/{party_id}/{hash}/{cached_answer_id} {
    	allow read;
    }

    match /cached_answers/{context_id}/{party_id}/{hash}/{cached_answer_id} {
    	allow read;
    }

    match /cached_answers/{document=**} {
    	allow read;
    }

    match /shareable_chat_session_snapshots/{doc_id} {
    	allow read;
    }

    match /sources/{source_id} {
    	allow read;

      match /source_documents/{doc_id} {
      	allow read;
      }

      match /parties/{party_id}/source_documents/{doc_id} {
        allow read;
      }
    }

    match /proposed_questions/{id} {
    	allow read;
    }

    match /proposed_questions/{session_type}/questions/{question_id} {
    	allow read;
    }

    match /proposed_questions/{context_id}/parties/{party_id}/questions/{question_id} {
    	allow read;
    }

    match /frequently_asked_questions/{question} {
    	allow read;
    }

    match /users/{user_id} {
    	allow read, write: if request.auth != null && request.auth.uid == user_id;
    }

    match /users/{user_id}/chat_sessions/{session_id} {
      allow read, write: if request.auth != null && request.auth.uid == user_id;
    }

    match /wahl_swiper_results/{result_id} {
      allow read: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['user_id'])
        && request.resource.data.user_id is string
        && request.resource.data.user_id == request.auth.uid;

      allow update: if request.auth != null
        && request.resource.data.keys().hasAll(['user_id'])
        && request.resource.data.user_id is string
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id;
    }

    match /chat_sessions/{session_id} {
      allow read: if (request.auth != null && resource.data.user_id == request.auth.uid) || resource.data.is_public == true;

      allow list: if request.auth != null && (
        request.query.filters.size() >= 1 &&
        'user_id' in request.query.filters.toMap() &&
        request.query.filters[0] == ['user_id', '==', request.auth.uid]
      );

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['user_id'])
        && request.resource.data.user_id is string
        && request.resource.data.user_id == request.auth.uid;

      allow update: if request.auth != null
        && request.resource.data.keys().hasAll(['user_id'])
        && request.resource.data.user_id is string
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id;

      allow delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;

      match /messages/{message_id} {
        // Mirror parent chat_sessions ownership/privacy (CR-03): a message body
        // is user content and must not be world-readable/writable. The enclosing
        // match binds {session_id}, so look up the parent session directly.
        allow read, list: if (request.auth != null
            && get(/databases/$(database)/documents/chat_sessions/$(session_id)).data.user_id == request.auth.uid)
            || get(/databases/$(database)/documents/chat_sessions/$(session_id)).data.is_public == true;
        allow create, update, delete: if request.auth != null
            && get(/databases/$(database)/documents/chat_sessions/$(session_id)).data.user_id == request.auth.uid;
      }
    }

    // GDPR Art. 9: political opinion data requires explicit consent before write
    // Source: https://firebase.google.com/docs/firestore/security/rules-conditions
    match /users/{user_id}/answers/{answer_id} {
      allow read: if request.auth != null && request.auth.uid == user_id;
      // create/update of special-category political data requires explicit consent (Art. 9)
      allow create, update: if request.auth != null
        && request.auth.uid == user_id
        && get(/databases/$(database)/documents/users/$(user_id)).data.consent.political_data == true;
      // erasure (Art. 17) must NOT require consent — a user who has withdrawn
      // consent must still be able to delete their own political-opinion answers
      allow delete: if request.auth != null && request.auth.uid == user_id;
    }
  }
}
