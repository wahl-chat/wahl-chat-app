API_NAME=wahl-chat-api
ENV=dev

# Optional: override the local dev server bind address.
# Unset => defaults to 127.0.0.1:8080 (matches web/.env.example).
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8080
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=wahl-chat-dev
OPENAI_API_KEY=your_openai_api_key
PERPLEXITY_API_KEY=perplexity_api_key
OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
GOOGLE_API_KEY=your_google_api_key
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_URL=your_qdrant_url

# Exploration Study Admin
STUDY_ADMIN_KEY=your_study_admin_key
STUDY_BASE_URL=http://localhost:3000

# Prolific completion codes, keyed by Prolific STUDY_ID. The participant
# return URL is built as
# https://app.prolific.com/submissions/complete?cc=<code-for-this-study>.
# If the entry is missing for a session's Prolific STUDY_ID, the Prolific
# return UI is hidden.
PROLIFIC_COMPLETION_CODES={"prolific_study_id_example":"completion_code_example"}

# Optional: map incoming Prolific STUDY_ID values to internal study IDs.
# JSON object: {"<prolific_study_id>": "<internal_study_id>"}.
# Unmapped or absent values fall back to EXPLORATION_STUDY_DEFAULT_ID.
PROLIFIC_STUDY_ID_MAP={"prolific_study_id_example":"internal_study_id_example"}
